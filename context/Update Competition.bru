meta {
  name: Update Competition
  type: http
  seq: 5
}

put {
  url: {{host}}/api/v1/competition/:team_id
  body: multipartForm
  auth: bearer
}

params:path {
  team_id: {{team_id}}
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  team_name: Team Omega Updated
  university: Institut Teknologi Bandung
  participants[0][id]: {{participant_id}}
  participants[0][name]: John Doe Updated
  participants[0][major]: Teknik Perminyakan
  participants[0][batch]: 2021
  participants[0][phone_number]: 081234567890
  participants[0][student_id_card]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
  participants[0][twibbon_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
  participants[0][story_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
  participants[0][follow_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
  participants[0][follow_linkedin]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
  participants[0][follow_tiktok]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
  participants[0][repost_competition_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
}

vars:pre-request {
  team_id: ad19a8b4-1271-423d-b831-fe4733392d1e
  participant_id: ca6183b5-9510-4f19-9f8c-45c5fe6d13ef
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Authenticated user endpoint to update competition team data while the team status is still incomplete.

  Frontend rule:
  - if team status is incomplete, submit to PUT /api/v1/competition/:team_id
  - if team status is rejected, do not use this endpoint; submit to PUT /api/v1/competition/resubmit/:team_id instead

  Notes:
  - request format is multipart/form-data
  - this endpoint can update team_name, university, existing participants, and add new participants in the same request
  - if the team is rejected and frontend still calls this endpoint, backend returns a 400 with a message explaining to use the resubmit endpoint
}

example {
  name: Success

  request: {
    url: {{host}}/api/v1/competition/:team_id
    method: PUT
    mode: multipartForm
    params:path: {
      team_id: {{team_id}}
    }

    body:multipart-form: {
      team_name: Team Omega Updated
      university: Institut Teknologi Bandung
      participants[0][id]: {{participant_id}}
      participants[0][name]: John Doe Updated
      participants[0][major]: Teknik Perminyakan
      participants[0][batch]: 2021
      participants[0][phone_number]: 081234567890
      participants[0][student_id_card]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][twibbon_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][story_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][follow_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][follow_linkedin]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][follow_tiktok]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][repost_competition_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
    }
  }

  response: {
    headers: {
      access-control-allow-credentials: true
      access-control-allow-headers: Origin, Content-Type, api_key, Content-Length, Accept-Encoding, X-CSRF-Token, Authorization
      access-control-allow-methods: POST, GET, OPTIONS, PATCH, PUT, DELETE, UPDATE
      access-control-allow-origin: *
      access-control-expose-headers: Content-Length
      access-control-max-age: 86400
      cache-control: no-cache
      content-type: application/json; charset=utf-8
      date: Sat, 07 Mar 2026 06:07:07 GMT
      content-length: 259
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "success update competition",
          "data": {
            "team_name": "Team Omega Updated",
            "university": "Institut Teknologi Bandung",
  "event": "Paper and Poster Competition Petrolida 2026",
            "email": "larawoc851@pckage.com",
            "status": "incomplete",
            "stage": "registration"
          }
        }
      '''
    }
  }
}

example {
  name: Failed | Rejected Team Must Resubmit

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "rejected teams must use the resubmit endpoint",
          "error": "rejected teams must use the resubmit endpoint"
        }
      '''
    }
  }
}
