meta {
  name: Check Referral Code
  type: http
  seq: 4
}

get {
  url: {{host}}/api/v1/referral-code/validate?code=REFCODE123&event_id={{event_id}}
  body: none
  auth: inherit
}

params:query {
  code: REFCODE123
  event_id: {{event_id}}
}

vars:pre-request {
  event_id: 1e2d6522-8339-4a92-9bf4-7453ddaa7a29
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: success
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "success validate referral code",
          "data": {
            "valid": true,
            "discount_amount": 50000
          }
        }
      '''
    }
  }
}
