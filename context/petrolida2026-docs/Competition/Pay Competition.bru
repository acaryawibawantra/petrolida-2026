meta {
  name: Pay Competition
  type: http
  seq: 3
}

post {
  url: {{host}}/api/v1/competition/pay
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  // {
  //   "voucher_code": "VOUCHER123",
  //   "payment_method": "BRIVA"
  // }
  
  
  
  // For International
  // all field not required
  {}
  
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Success Paypal
  
  request: {
    url: {{host}}/api/v1/competition/pay
    method: POST
    mode: json
    body:json: {
      // {
      //   "voucher_code": "VOUCHER123",
      //   "payment_method": "BRIVA"
      // }
        
        
        
      // For International
      // all field not required
      {
          "voucher_code": ""
      }
        
    }
  }
  
  response: {
    headers: {
      access-control-allow-credentials: true
      access-control-allow-headers: Origin, Content-Type, api_key, Content-Length, Accept-Encoding, X-CSRF-Token, Authorization
      access-control-allow-methods: POST, GET, OPTIONS, PATCH, PUT, DELETE, UPDATE
      access-control-allow-origin: *
      access-control-expose-headers: Content-Length
      access-control-max-age: 86400
      cache-control: no-cache
      content-type: application/json; charset=utf-8
      date: Sat, 07 Mar 2026 05:59:42 GMT
      content-length: 107
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "success pay competition",
          "data": {
            "invoice_url": "https://paypal.me/kafanalkafi",
            "total_price": 225000,
            "discount_amount": 0,
            "final_price": 225000,
            "voucher_code": "",
            "is_free_payment": false
          }
        }
      '''
    }
  }
}
