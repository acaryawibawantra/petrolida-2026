    url: {{host}}/api/v1/competition/:id/participant
    method: POST
    mode: multipartForm
    params:path: {
      id: {{team_id}}
    }

    body:multipart-form: {
      name: Overflow Member
      major: Teknik Perminyakan
      batch: 2021
      email: overflow@example.com
      phone_number: 081234567893
      student_id_card: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      twibbon_ig: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      story_ig: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      follow_ig: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      follow_linkedin: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      follow_tiktok: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      repost_competition_ig: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "competition excedeed limit 2",
          "error": "competition excedeed limit 2"
        }
      '''
    }
  }
}

example {
  name: Failed | Validation

  request: {
    url: {{host}}/api/v1/competition/:id/participant
    method: POST
    mode: multipartForm
    params:path: {
      id: {{team_id}}
    }

    body:multipart-form: {
      name: Invalid Participant
      major: Teknik Perminyakan
      batch: 2021
      email: invalid@example.com
      phone_number: 0812-345-678
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "student_id_card is required",
          "error": "student_id_card is required"
        }
      '''
    }
  }
}
