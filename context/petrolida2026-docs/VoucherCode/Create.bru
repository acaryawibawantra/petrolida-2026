meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/voucher-code
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "VOUCHER123",
    "name": "Test Voucher",
    "description": "Discount for competition registration",
    "amount": 10000,
    "type": "fixed_amount",
    "quantity": 100,
    "usage_limit": 1,
    "start_date": "2026-03-19 00:00:00",
    "expiry_date": "2026-12-31 23:59:59",
    "status": "active"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
