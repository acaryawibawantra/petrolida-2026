meta {
  name: Update Product
  type: http
  seq: 11
}

put {
  url: {{host}}/api/v1/product/{{product_id}}
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  name: Jersey Petrolida 2026 Updated
  product_category: c3d4e5f6-7a8b-9c0d-1e2f-3a4b5c6d7e8f
  description: Jersey official Petrolida 2026 dengan material premium - Updated
  price: 175000
  stock: 120
  is_active: true
  is_preorder: false
  variants: [{"value":"Hijau"},{"value":"Biru"}]
  sizes: [{"value":"XL"},{"value":"M"}]
  assets: @file(C:\Users\user\Pictures\example.jpg)
}

vars:pre-request {
  product_id: 9f64034c-f9b8-43c0-a1fc-76d823a3ec8b
}

settings {
  encodeUrl: true
  timeout: 0
}
