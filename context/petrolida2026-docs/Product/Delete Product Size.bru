meta {
  name: Delete Product Size
  type: http
  seq: 8
}

delete {
  url: {{host}}/api/v1/product/{{product_id}}/sizes/{{size_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  product_id: d4e5f6a7-8b9c-0d1e-2f3a-4b5c6d7e8f9a
  size_id: f6a7b8c9-0d1e-2f3a-4b5c-6d7e8f9a0b1c
}

settings {
  encodeUrl: true
  timeout: 0
}
