meta {
  name: Delete Product Variant
  type: http
  seq: 6
}

delete {
  url: {{host}}/api/v1/product/{{product_id}}/variants/{{variant_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  product_id: d4e5f6a7-8b9c-0d1e-2f3a-4b5c6d7e8f9a
  variant_id: e5f6a7b8-9c0d-1e2f-3a4b-5c6d7e8f9a0b
}

settings {
  encodeUrl: true
  timeout: 0
}
