meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/product
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  name: Jersey Petrolida 2026
  product_category: c3d4e5f6-7a8b-9c0d-1e2f-3a4b5c6d7e8f
  description: Jersey official Petrolida 2026 dengan material premium
  price: 150000
  stock: 100
  is_preorder: false
  is_active: true
  variants: [{"value":"Merah"},{"value":"Biru"}]
  sizes: [{"value":"S"},{"value":"M"},{"value":"L"}]
  assets:
}

settings {
  encodeUrl: true
  timeout: 0
}
