meta {
  name: Get by ID
  type: http
  seq: 1
}

get {
  url: {{host}}/api/v1/petrovis/{{petrovis_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

vars:post-response {
  petrovis_id: res.body.data.id
}

settings {
  encodeUrl: true
  timeout: 0
}

