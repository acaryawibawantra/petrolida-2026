        {
          "success": false,
          "message": "leader email format is invalid"
        }
      '''
    }
  }
}

example {
  name: Error | File Exceeds 10MB Limit

  request: {
    url: {{host}}/api/v1/competition
    method: POST
    mode: multipartForm
    body:multipart-form: {
      team_name: Team Gamma
      university: Institut Teknologi Bandung
      event_id: {{event_id}}
      participants[0][name]: John Doe
      participants[0][major]: Teknik Perminyakan
      participants[0][batch]: 2021
      participants[0][email]: johndoe@example.com
      participants[0][phone_number]: 081234567890
      participants[0][student_id_card]: @file(C:\Users\Rani\Downloads\test api\large_file.jpg)
      participants[0][twibbon_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][story_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][follow_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][follow_linkedin]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][follow_tiktok]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
      participants[0][repost_competition_ig]: @file(C:\Users\Rani\Downloads\test api\meeeee.jpg)
    }
  }

  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }

    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "success": false,
          "message": "leader student_id_card exceeds 10mb limit"
        }
      '''
    }
  }
}

